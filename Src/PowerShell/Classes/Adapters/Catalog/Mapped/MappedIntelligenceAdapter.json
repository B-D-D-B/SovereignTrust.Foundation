          "adapters": [
            "Intelligence_AzureFoundry",
            "Intelligence_CodexCLI"
          ]
        },
        {
          "path": "Config.Prompt.Media[*][$name]",
          "description": "Validate the value of an unsupported literal request member.",
          "adapters": [
            "Intelligence_CodexCLI"
          ],
          "pathKind": "dynamic",
          "pathExpression": "Get-CodexCLILiteralMember $Object $name | Select-Object -Last 1"
        },
        {
          "path": "Config.Prompt.System",
          "description": "Read the system input from the original structured prompt after validation.",
          "adapters": [
            "Intelligence_AzureFoundry",
            "Intelligence_CodexCLI"
          ]
        },
        {
          "path": "Config.Prompt.Texts",
          "description": "Read text inputs from the original structured prompt after validation.",
          "adapters": [
            "Intelligence_AzureFoundry",
            "Intelligence_CodexCLI"
          ]
        },
        {
          "path": "Config.Prompt[$name]",
          "description": "Validate the value of an unsupported literal request member.",
          "adapters": [
            "Intelligence_CodexCLI"
          ],
          "pathKind": "dynamic",
          "pathExpression": "Get-CodexCLILiteralMember $Object $name | Select-Object -Last 1"
        },
        {
          "path": "Config[$name]",
          "description": "Validate the value of an unsupported literal request member.",
          "adapters": [
            "Intelligence_CodexCLI"
          ],
          "pathKind": "dynamic",
          "pathExpression": "Get-CodexCLILiteralMember $Object $name | Select-Object -Last 1"
        },
        {
          "path": "Phase",
          "description": "Preserve conduction context when cloning the Foundry request.",
          "adapters": [
            "Intelligence_AzureFoundry"
          ]
        },
        {
          "path": "Plan",
          "description": "Preserve conduction context when cloning the Foundry request.",
          "adapters": [
            "Intelligence_AzureFoundry"
          ]
        }
      ]
    },
