{
  "name": "MappedIntelligenceAdapter",
  "activities": [
    {
      "name": "SendMessage",
      "description": "Send a request to an intelligence service.",
      "properties": [
        {
          "path": "Config",
          "description": "Extract the message request configuration after adapter validation.",
          "adapters": [
            "Intelligence_AzureFoundry",
            "Intelligence_CodexCLI"
          ]
        },
        {
          "path": "Config.Content",
          "description": "Read the message Content input after preceding request validation.",
          "adapters": [
            "Intelligence_CodexCLI",
            "Intelligence_AzureFoundry"
          ]
        },
        {
          "path": "Config.MediaPath",
          "description": "Read Foundry MediaPath request input.",
          "adapters": [
            "Intelligence_AzureFoundry"
          ]
        },
        {
          "path": "Config.MediaUrl",
          "description": "Read Foundry MediaUrl request input.",
          "adapters": [
            "Intelligence_AzureFoundry"
          ]
        },
        {
          "path": "Config.Model",
          "description": "Read Foundry Model request input.",
          "adapters": [
            "Intelligence_AzureFoundry"
          ]
        },
        {
          "path": "Config.ModelKey",
          "description": "Read the request ModelKey after preceding validation.",
          "adapters": [
            "Intelligence_CodexCLI",
            "Intelligence_AzureFoundry"
          ]
        },
        {
          "path": "Config.OutputSchema",
          "description": "Read CodexCLI OutputSchema input.",
          "adapters": [
            "Intelligence_CodexCLI"
          ]
        },
        {
          "path": "Config.OutputSchema.$schema",
          "description": "Validate output-schema $schema.",
          "adapters": [
            "Intelligence_CodexCLI"
          ]
        },
        {
          "path": "Config.OutputSchema.additionalProperties",
          "description": "Validate output-schema additionalProperties.",
          "adapters": [
            "Intelligence_CodexCLI"
          ]
        },
        {
          "path": "Config.OutputSchema.properties",
          "description": "Validate output-schema properties.",
          "adapters": [
            "Intelligence_CodexCLI"
          ]
        },
        {
          "path": "Config.OutputSchema.properties[$name]",
          "description": "Validate a caller-named output-schema property object.",
          "adapters": [
            "Intelligence_CodexCLI"
          ],
          "pathKind": "dynamic",
          "pathExpression": "Get-CodexCLILiteralMember $properties $name | Select-Object -Last 1"
        },
        {
          "path": "Config.OutputSchema.properties[$name].type",
          "description": "Validate the scalar type of a caller-named output-schema property.",
          "adapters": [
            "Intelligence_CodexCLI"
          ],
          "pathKind": "dynamic",
          "pathExpression": "Resolve-PathFromDictionary -Dictionary $property -Path 'type' -SignalLevel 'Information' | Select-Object -Last 1"
        },
        {
          "path": "Config.OutputSchema.required",
          "description": "Validate output-schema required.",
          "adapters": [
            "Intelligence_CodexCLI"
          ]
        },
        {
          "path": "Config.OutputSchema.type",
          "description": "Validate output-schema type.",
          "adapters": [
            "Intelligence_CodexCLI"
          ]
        },
        {
          "path": "Config.Prompt",
          "description": "Read CodexCLI Prompt input.",
          "adapters": [
            "Intelligence_CodexCLI"
          ]
        },
        {
          "path": "Config.Prompt.Media",
          "description": "Read media inputs from the original structured prompt after validation.",
          "adapters": [
            "Intelligence_AzureFoundry",
            "Intelligence_CodexCLI"
          ]
        },
        {
          "path": "Config.Prompt.Media[*].Detail",
          "description": "Read Detail from an original structured prompt media entry, after validation and only while original entries remain selected.",
          "adapters": [
            "Intelligence_AzureFoundry",
            "Intelligence_CodexCLI"
          ]
        },
        {
          "path": "Config.Prompt.Media[*].MediaPath",
          "description": "Read MediaPath from an original structured prompt media entry, after validation and only while original entries remain selected.",
          "adapters": [
            "Intelligence_AzureFoundry",
            "Intelligence_CodexCLI"
          ]
        },
        {
          "path": "Config.Prompt.Media[*].MediaType",
