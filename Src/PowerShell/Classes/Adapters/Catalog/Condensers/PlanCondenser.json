      "properties": [
        {
          "path": "Adapter",
          "description": "Identify the iteration trace adapter and select the condenser slot for the cloned iteration plan.",
          "adapters": [
            "PlanCondenser"
          ]
        },
        {
          "path": "Config.Activity",
          "description": "Name the iteration trace activity and select the activity executed for the cloned iteration plan.",
          "adapters": [
            "PlanCondenser"
          ]
        },
        {
          "path": "Config.IterationArray",
          "description": "Supply the iteration values and cardinality used to select serial and parallel work.",
          "adapters": [
            "PlanCondenser"
          ]
        },
        {
          "path": "Config.IterationName",
          "description": "Name the registered iteration signal.",
          "adapters": [
            "PlanCondenser"
          ],
          "default": {
            "PlanCondenser": "Iteration"
          }
        },
        {
          "path": "Config.Threading.DebugInline",
          "description": "Select inline debug execution when deciding and invoking parallel work.",
          "adapters": [
            "PlanCondenser"
          ],
          "default": {
            "PlanCondenser": false
          }
        },
        {
          "path": "Config.Threading.DebugWorkItemIndex",
          "description": "Select the work-item index for inline debugging.",
          "adapters": [
            "PlanCondenser"
          ],
          "default": {
            "PlanCondenser": {
              "expression": "$warmupCount",
              "representation": "powershell-expression"
            }
          }
        },
        {
          "path": "Config.Threading.Enabled",
          "description": "Enable consideration of threaded iteration and validate that the option is boolean.",
          "adapters": [
            "PlanCondenser"
          ],
          "default": {
            "PlanCondenser": false
          }
        },
        {
          "path": "Config.Threading.MaxThreads",
