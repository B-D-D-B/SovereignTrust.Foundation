              {
                "condition": "Config.ResultDetail=true, decoded path route, matching usable session, keyed usable Plan and nonfailed Conduction invocation",
                "signalState": "success",
                "hasResult": true,
                "resultType": "PSCustomObject",
                "shape": [
                  { "path": "$.Route", "type": "String", "presence": "required", "meaning": "normalized selected path route, correlation only", "origin": "copied-input" },
                  { "path": "$.SessionResolved", "type": "Boolean", "presence": "required", "meaning": "true after nonfailed Session Signal and matching unwrapped ID", "origin": "computed" },
                  { "path": "$.PlanLoaded", "type": "Boolean", "presence": "required", "meaning": "true after nonfailed Memory.Generate and usable keyed Name/Phases Plan", "origin": "computed" },
                  { "path": "$.ConductionCompleted", "type": "Boolean", "presence": "required", "meaning": "true after returned nonfailed Conduction Signal; HasResult not required", "origin": "computed" }
