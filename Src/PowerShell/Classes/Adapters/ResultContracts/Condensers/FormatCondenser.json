      "name": "Json",
      "resultContract": {
        "boundary": "condenser leaf Signal.Result and normal MappedCondenserAdapter exposure",
        "variants": [
          {
            "adapter": "FormatCondenser",
            "support": "implemented",
            "when": "both verbs call Invoke-FormatJson; Plan.Format selects actual JSON mode",
            "outcomes": [
              {
                "condition": "Json or JsonArray parse returns nonnull value",
                "signalState": "success",
                "hasResult": true,
                "resultType": "native decoded scalar/object/array",
                "limitations": "JsonArray mode iterates and appends parsed elements; singleton cardinality depends on PowerShell pipeline"
              },
              {
                "condition": "Plan.Format=JsonArray with zero inputs or parsed null elements",
                "signalState": "success",
                "hasResult": true,
                "resultType": "Object[]",
                "example": {
                  "kind": "illustrative",
                  "value": []
                }
              },
              {
                "condition": "Plan.Format=Json parses JSON null, or unsupported Plan.Format has no SetResult",
                "signalState": "success",
                "hasResult": false,
                "resultType": "absent"
              },
              {
                "condition": "content absent or JSON parse fails",
                "signalState": "failure",
                "hasResult": false,
                "resultType": "absent"
              }
            ],
            "sideEffects": [],
