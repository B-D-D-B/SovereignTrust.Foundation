                    "presence": "conditional",
                    "meaning": "response body",
                    "origin": "provider-returned"
                  },
                  {
                    "path": "Url",
                    "type": "String",
                    "presence": "required",
                    "meaning": "final URL",
                    "origin": "computed"
                  },
                  {
                    "path": "Method",
                    "type": "String",
                    "presence": "required",
                    "meaning": "actual Config.Method",
                    "origin": "echoed-input"
                  },
                  {
                    "path": "ResourceName",
                    "type": "String",
                    "presence": "conditional",
                    "meaning": "resolved resource",
                    "origin": "computed"
                  },
                  {
